# Database (Docker Compose overrides DATABASE_URL for the app service)
DATABASE_URL="postgresql://mejor:mejor@localhost:5432/mejor_ubicacion?schema=public"

# SerpAPI — Google Maps local search for competitors
# https://serpapi.com/google-maps-api
SERPAPI_API_KEY=""

# Optional: Google Geocoding (falls back to Nominatim/OSM if empty)
GOOGLE_MAPS_API_KEY=""

# Cost controls
SERPAPI_DAILY_BUDGET=100
PLACES_CACHE_TTL_DAYS=14
OSM_CACHE_TTL_DAYS=30
GEOCODE_CACHE_TTL_DAYS=30

# Protect calibration endpoint
CALIBRATE_SECRET="change-me-in-production"
