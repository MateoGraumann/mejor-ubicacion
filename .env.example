# Database (Docker Compose overrides DATABASE_URL for the app service)
DATABASE_URL="postgresql://mejor:mejor@localhost:5432/mejor_ubicacion?schema=public"

# Google Maps Platform (optional — Geocoding + Places)
# Without this key: geocoding uses OpenStreetMap Nominatim; Places/OSM use mocks if USE_MOCK_PROVIDERS=true
GOOGLE_MAPS_API_KEY=""

# Cost controls
PLACES_DAILY_BUDGET=100
PLACES_CACHE_TTL_DAYS=14
OSM_CACHE_TTL_DAYS=30
GEOCODE_CACHE_TTL_DAYS=30

# Protect calibration endpoint
CALIBRATE_SECRET="change-me-in-production"

# Mock Places/OSM only (geocoding always uses Nominatim or Google)
USE_MOCK_PROVIDERS="true"
